# ============================================================
# Bilibili Analytics Platform - Environment Variables Template
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env to version control!
# ============================================================

# Application
APP_NAME="Bilibili Analytics Platform"
APP_VERSION="2.0.0"
DEBUG=True

# Server
HOST="0.0.0.0"
PORT=8000

# Database
DATABASE_URL="sqlite:///./data/bilibili.db"

# MongoDB (optional, recommended for raw danmaku documents)
MONGODB_URI=""
MONGODB_DB_NAME="bilibili_analytics"
MONGODB_DANMAKU_COLLECTION="danmaku_raw"

# JWT Authentication
SECRET_KEY="change-this-to-a-strong-random-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# AI Service (optional - Doubao / Ark API)
DOUBAO_API_KEY=""
DOUBAO_API_URL="https://ark.cn-beijing.volces.com/api/v3/responses"
DOUBAO_MODEL=""

# Scraper control
BILIBILI_SESSDATA=""
BILIBILI_RETRY_ATTEMPTS=3
BILIBILI_RETRY_BACKOFF_BASE=0.8
BILIBILI_RETRY_BACKOFF_MAX=8
BILIBILI_REQUEST_JITTER=0.4
CRAWLER_PROXY_ENABLED=False
CRAWLER_PROXY_POOL=""
CRAWLER_COMMENT_PAGE_SIZE=20
CRAWLER_NESTED_REPLY_LIMIT=20
CRAWLER_NESTED_REPLY_PAGES=2
CRAWLER_HISTORY_MONTHS=24
