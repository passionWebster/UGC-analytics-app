# ============================================================
# Bilibili Analytics Platform - Environment Variables Template
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env to version control!
# ============================================================

# Application
APP_NAME="Bilibili Analytics Platform"
APP_VERSION="2.0.0"
DEBUG=True

# Server
HOST="0.0.0.0"
PORT=8000

# Database
DATABASE_URL="sqlite:///./data/bilibili.db"

# JWT Authentication
SECRET_KEY="change-this-to-a-strong-random-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# CORS (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# AI Service (optional - Doubao / Ark API)
DOUBAO_API_KEY=""
DOUBAO_API_URL="https://ark.cn-beijing.volces.com/api/v3/chat/completions"
DOUBAO_MODEL=""
