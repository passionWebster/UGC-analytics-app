# ============================================================
# UGC Streaming Analytics Platform - Environment Variables Template
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env to version control!
# ============================================================

# Application
APP_NAME="泛二次元流媒体数据智能分析与可视化平台"
APP_VERSION="2.0.0"
DEBUG=True

# Server
HOST="0.0.0.0"
PORT=8000

# Database
DATABASE_URL="sqlite:///./data/ugc_streaming_analytics.db"

# MongoDB (optional, recommended for raw danmaku documents)
MONGODB_URI=""
MONGODB_DB_NAME="ugc_streaming_analytics"
MONGODB_DANMAKU_COLLECTION="danmaku_raw"

# JWT Authentication
SECRET_KEY="change-this-to-a-strong-random-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# AI Service (optional - Doubao / Ark API)
DOUBAO_API_KEY=""
DOUBAO_API_URL="https://ark.cn-beijing.volces.com/api/v3/responses"
DOUBAO_MODEL=""

# Public data synchronization control
BILIBILI_SESSDATA=""
BILIBILI_RETRY_ATTEMPTS=3
BILIBILI_RETRY_BACKOFF_BASE=0.8
BILIBILI_RETRY_BACKOFF_MAX=8
BILIBILI_REQUEST_JITTER=0.4
CRAWLER_PROXY_ENABLED=False
CRAWLER_PROXY_POOL=""
CRAWLER_COMMENT_PAGE_SIZE=20
CRAWLER_NESTED_REPLY_LIMIT=20
CRAWLER_NESTED_REPLY_PAGES=2
CRAWLER_HISTORY_MONTHS=24

# NLP multiprocessing worker pool (Stage 2 NLP Async Pipeline)
NLP_WORKER_POOL_ENABLED=True
NLP_WORKER_START_METHOD="spawn"
NLP_WORKER_PROCESSES=2
NLP_WORKER_QUEUE_MAXSIZE=1000
NLP_WORKER_SHUTDOWN_TIMEOUT=5
NLP_ASYNC_FALLBACK_LOCAL=True

# NLP Pipeline
NLP_JIEBA_USER_DICT_PATH=""
NLP_KEYWORD_TOPK=20
NLP_ENTITY_TOPK=20
NLP_ENTITY_MIN_FREQ=2
NLP_SPAM_REPEAT_THRESHOLD=3
